      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlertTopic2720D535"
          }
        ],
        "AlarmDescription": "No copy of the prod app table's daily backup completed in supply-checkout-prod-backup-copies in the last 36 hours. The workload account's plan, copy rule or permissions may have been changed or deleted. Runbook: docs/backups.md, When copies stop arriving.",
        "AlarmName": "supply-checkout-prod-backup-copies-missing",
        "ComparisonOperator": "LessThanThreshold",
        "DatapointsToAlarm": 3,
        "EvaluationPeriods": 3,
        "Metrics": [
          {
            "Expression": "FILL(vault, 0) + FILL(dynamodb, 0)",
            "Id": "expr_1",
            "Label": "Copies completed in the vault",
            "ReturnData": true
          },
          {
            "Id": "vault",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "BackupVaultName",
                    "Value": "supply-checkout-prod-backup-copies"
                  }
                ],
                "MetricName": "NumberOfRecoveryPointsCompleted",
                "Namespace": "AWS/Backup"
              },
              "Period": 43200,
              "Stat": "Sum"
            },
            "ReturnData": false
          },
          {
            "Id": "dynamodb",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "BackupVaultName",
                    "Value": "supply-checkout-prod-backup-copies"
                  },
                  {
                    "Name": "ResourceType",
                    "Value": "DynamoDB"
                  }
                ],
                "MetricName": "NumberOfRecoveryPointsCompleted",
                "Namespace": "AWS/Backup"
              },
              "Period": 43200,
              "Stat": "Sum"
            },
            "ReturnData": false
          }
        ],
        "OKActions": [
          {
            "Ref": "AlertTopic2720D535"
          }
        ],
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout"
          },
          {
            "Key": "component",
            "Value": "backup-vault"
          },
          {
            "Key": "env",
            "Value": "prod"
          },
          {
            "Key": "layer",
            "Value": "stateful"
          },
          {
            "Key": "managed-by",
            "Value": "cdk"
          }
        ],
        "Threshold": 1,
        "TreatMissingData": "breaching"
      }
    },
