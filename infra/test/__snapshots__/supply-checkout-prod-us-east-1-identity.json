    "PostConfirmationNoticeAddress390C9F8D": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "dynamodb:GetItem",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "USER#*"
                  ]
                },
                "ForAllValues:StringEquals": {
                  "dynamodb:Attributes": [
                    "PK",
                    "SK",
                    "noticeAddressAt"
                  ]
                },
                "StringEqualsIfExists": {
                  "dynamodb:Select": "SPECIFIC_ATTRIBUTES"
                }
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:dynamodb:us-east-1:",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":table/supply-checkout-prod-app"
                  ]
                ]
              },
              "Sid": "ReadNoticeAddressRecorded"
            },
            {
              "Action": [
                "dynamodb:ConditionCheckItem",
                "dynamodb:UpdateItem"
              ],
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "USER#*"
                  ]
                },
                "ForAllValues:StringEquals": {
                  "dynamodb:Attributes": [
                    "PK",
                    "SK",
                    "noticeAddress",
                    "noticeAddressAt",
                    "noticeSeenHash"
                  ]
                },
                "StringEqualsIfExists": {
                  "dynamodb:ReturnValues": "NONE"
                }
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:dynamodb:us-east-1:",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":table/supply-checkout-prod-app"
                  ]
                ]
              },
              "Sid": "RecordNoticeAddress"
            },
            {
              "Action": [
                "kms:Decrypt",
                "kms:DescribeKey",
                "kms:Encrypt",
                "kms:GenerateDataKey"
              ],
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": {
                    "Fn::Join": [
                      "",
                      [
                        "dynamodb.",
                        {
                          "Ref": "AWS::Region"
                        },
                        ".amazonaws.com"
                      ]
                    ]
                  }
                }
              },
              "Effect": "Allow",
              "Resource": {
                "Ref": "SsmParameterValuesupplycheckoutproddatatablekeyarnC96584B6F00A464EAD1953AFF4B05118Parameter"
              },
              "Sid": "TableKeyThroughDynamoDb"
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "PostConfirmationNoticeAddress390C9F8D",
        "Roles": [
          {
            "Ref": "PostConfirmationRoleBD0B0389"
          }
        ]
      }
    },
