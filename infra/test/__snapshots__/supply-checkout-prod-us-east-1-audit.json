{
  "Resources": {
    "StackInfoC49BCBCF": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "Supply Checkout audit stack (stateful)",
        "Name": "/supply-checkout/prod/audit/stack",
        "Tags": {
          "app": "supply-checkout",
          "component": "audit",
          "env": "prod",
          "layer": "stateful",
          "managed-by": "cdk"
        },
        "Type": "String",
        "Value": "{\"stackName\":\"supply-checkout-prod-us-east-1-audit\",\"layer\":\"stateful\"}"
      }
    },
    "TrailKey38EB2549": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "Description": "Encrypts the Supply Checkout CloudTrail trail's log and digest files",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":root"
                    ]
                  ]
                }
              },
              "Resource": "*"
            },
            {
              "Action": "kms:GenerateDataKey*",
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition"
                        },
                        ":cloudtrail:",
                        {
                          "Ref": "AWS::Region"
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":trail/supply-checkout-prod-trail"
                      ]
                    ]
                  },
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "StringLike": {
                  "kms:EncryptionContext:aws:cloudtrail:arn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition"
                        },
                        ":cloudtrail:*:",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":trail/*"
                      ]
                    ]
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Resource": "*",
              "Sid": "CloudTrailEncryptsThisTrailsLogs"
            },
            {
              "Action": "kms:DescribeKey",
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition"
                        },
                        ":cloudtrail:",
                        {
                          "Ref": "AWS::Region"
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":trail/supply-checkout-prod-trail"
                      ]
                    ]
                  },
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Resource": "*",
              "Sid": "CloudTrailDescribesTheKey"
            }
          ],
          "Version": "2012-10-17"
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout"
          },
          {
            "Key": "component",
            "Value": "audit"
          },
          {
            "Key": "env",
            "Value": "prod"
          },
          {
            "Key": "layer",
            "Value": "stateful"
          },
          {
            "Key": "managed-by",
            "Value": "cdk"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain"
    },
    "TrailKeyAliasF69C9B00": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/supply-checkout-prod-trail",
        "TargetKeyId": {
          "Fn::GetAtt": [
            "TrailKey38EB2549",
            "Arn"
          ]
        }
      }
    },
    "TrailBucketA831CE63": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "BucketKeyEnabled": false,
              "ServerSideEncryptionByDefault": {
                "KMSMasterKeyID": {
                  "Fn::GetAtt": [
                    "TrailKey38EB2549",
                    "Arn"
                  ]
                },
                "SSEAlgorithm": "aws:kms"
              }
            }
          ]
        },
        "BucketName": {
          "Fn::Join": [
            "",
            [
              "supply-checkout-prod-trail-us-east-1-",
              {
                "Ref": "AWS::AccountId"
              }
            ]
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "ExpirationInDays": 400,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "Status": "Enabled"
            }
          ]
        },
        "LoggingConfiguration": {
          "DestinationBucketName": {
            "Fn::Join": [
              "",
              [
                "supply-checkout-prod-logs-us-east-1-",
                {
                  "Ref": "AWS::AccountId"
                }
              ]
            ]
          },
          "LogFilePrefix": "s3/trail/"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout"
          },
          {
            "Key": "component",
            "Value": "audit"
          },
          {
            "Key": "env",
            "Value": "prod"
          },
          {
            "Key": "layer",
            "Value": "stateful"
          },
          {
            "Key": "managed-by",
            "Value": "cdk"
          }
        ],
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain"
    },
    "TrailBucketPolicyFEBC3C5C": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "TrailBucketA831CE63"
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*"
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "TrailBucketA831CE63",
                    "Arn"
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "TrailBucketA831CE63",
                          "Arn"
                        ]
                      },
                      "/*"
                    ]
                  ]
                }
              ]
            },
            {
              "Action": "s3:GetBucketAcl",
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition"
                        },
                        ":cloudtrail:",
                        {
                          "Ref": "AWS::Region"
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":trail/supply-checkout-prod-trail"
                      ]
                    ]
                  },
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Resource": {
                "Fn::GetAtt": [
                  "TrailBucketA831CE63",
                  "Arn"
                ]
              },
              "Sid": "CloudTrailChecksTheBucketAcl"
            },
            {
              "Action": "s3:PutObject",
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition"
                        },
                        ":cloudtrail:",
                        {
                          "Ref": "AWS::Region"
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":trail/supply-checkout-prod-trail"
                      ]
                    ]
                  },
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  },
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "TrailBucketA831CE63",
                        "Arn"
                      ]
                    },
                    "/AWSLogs/",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    "/*"
                  ]
                ]
              },
              "Sid": "CloudTrailWritesThisAccountsLogs"
            }
          ],
          "Version": "2012-10-17"
        }
      }
    },
    "Trail": {
      "Type": "AWS::CloudTrail::Trail",
      "Properties": {
        "EnableLogFileValidation": true,
        "EventSelectors": [
          {
            "IncludeManagementEvents": true,
            "ReadWriteType": "All"
          }
        ],
        "IncludeGlobalServiceEvents": true,
        "IsLogging": true,
        "IsMultiRegionTrail": true,
        "KMSKeyId": {
          "Fn::GetAtt": [
            "TrailKey38EB2549",
            "Arn"
          ]
        },
        "S3BucketName": {
          "Ref": "TrailBucketA831CE63"
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout"
          },
          {
            "Key": "component",
            "Value": "audit"
          },
          {
            "Key": "env",
            "Value": "prod"
          },
          {
            "Key": "layer",
            "Value": "stateful"
          },
          {
            "Key": "managed-by",
            "Value": "cdk"
          }
        ],
        "TrailName": "supply-checkout-prod-trail"
      },
      "DependsOn": [
        "TrailBucketPolicyFEBC3C5C",
        "TrailKeyAliasF69C9B00",
        "TrailKey38EB2549"
      ],
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain"
    },
    "TrailNameParamA946EDFC": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "The account's CloudTrail trail",
        "Name": "/supply-checkout/prod/audit/trail-name",
        "Tags": {
          "app": "supply-checkout",
          "component": "audit",
          "env": "prod",
          "layer": "stateful",
          "managed-by": "cdk"
        },
        "Type": "String",
        "Value": "supply-checkout-prod-trail"
      }
    },
    "TrailBucketParamD0946447": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "The CloudTrail trail's bucket",
        "Name": "/supply-checkout/prod/audit/trail-bucket-name",
        "Tags": {
          "app": "supply-checkout",
          "component": "audit",
          "env": "prod",
          "layer": "stateful",
          "managed-by": "cdk"
        },
        "Type": "String",
        "Value": {
          "Ref": "TrailBucketA831CE63"
        }
      }
    },
    "TrailKeyArnParam5EFB3820": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Description": "KMS key ARN for the CloudTrail trail's files",
        "Name": "/supply-checkout/prod/audit/trail-key-arn",
        "Tags": {
          "app": "supply-checkout",
          "component": "audit",
          "env": "prod",
          "layer": "stateful",
          "managed-by": "cdk"
        },
        "Type": "String",
        "Value": {
          "Fn::GetAtt": [
            "TrailKey38EB2549",
            "Arn"
          ]
        }
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
