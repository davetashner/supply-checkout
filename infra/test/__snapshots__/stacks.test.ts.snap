exports[`stack layout > matches the template snapshots > supply-checkout-prod-us-east-1-api 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "StackInfoC49BCBCF": {
      "Properties": {
        "Description": "Supply Checkout api stack (stateless)",
        "Name": "/supply-checkout/prod/api/stack",
        "Tags": {
          "app": "supply-checkout",
          "component": "api",
          "env": "prod",
          "layer": "stateless",
          "managed-by": "cdk",
        },
        "Type": "String",
        "Value": "{"stackName":"supply-checkout-prod-us-east-1-api","layer":"stateless"}",
      },
      "Type": "AWS::SSM::Parameter",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

