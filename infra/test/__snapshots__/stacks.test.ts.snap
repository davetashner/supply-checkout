      },
      "Type": "AWS::SNS::Topic",
    },
    "AlarmTopicsP1Policy93E4769E": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sns:Publish",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false",
