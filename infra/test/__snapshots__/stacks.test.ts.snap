        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "IF(d >= 20, 100 * FILL(n, 0) / d, 0)",
            "Id": "expr_1",
            "Label": "Lambda error rate % (us-east-1)",
