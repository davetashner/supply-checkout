    "JourneyAlarmsapierrorsF3DBF597": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicsP1E7C597D3",
          },
        ],
        "AlarmDescription": "P1 API errors (Every journey, us-east-1). API Gateway 5xx above 2% of requests for 5 minutes, once there are at least 20 requests. Across all of the API's routes: per-route metrics need detailed metrics, billed per route; the access logs have the route. Thresholds and runbooks: docs/journeys.md, Alarms for blocked journeys.",
        "AlarmName": "supply-checkout-prod-p1-api-errors",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "IF(d >= 20, 100 * FILL(n, 0) / d, 0)",
            "Id": "expr_1",
            "Label": "API 5xx rate % (us-east-1)",
            "ReturnData": true,
          },
          {
            "Id": "n",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": {
                      "Ref": "SsmParameterValuesupplycheckoutprodapiapiidC96584B6F00A464EAD1953AFF4B05118Parameter",
                    },
                  },
                ],
                "MetricName": "5xx",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "d",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": {
                      "Ref": "SsmParameterValuesupplycheckoutprodapiapiidC96584B6F00A464EAD1953AFF4B05118Parameter",
                    },
                  },
                ],
                "MetricName": "Count",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopicsP1E7C597D3",
          },
        ],
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout",
          },
          {
            "Key": "component",
            "Value": "observability",
          },
          {
            "Key": "env",
            "Value": "prod",
          },
          {
            "Key": "layer",
            "Value": "stateless",
          },
          {
            "Key": "managed-by",
            "Value": "cdk",
          },
        ],
        "Threshold": 2,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "JourneyAlarmsapislow4CCA5606": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicsP213C63151",
          },
        ],
        "AlarmDescription": "P2 API slow (Every journey, us-east-1). API Gateway Latency p95 above 2 seconds over 10 minutes. Thresholds and runbooks: docs/journeys.md, Alarms for blocked journeys.",
        "AlarmName": "supply-checkout-prod-p2-api-slow",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "ApiId",
            "Value": {
              "Ref": "SsmParameterValuesupplycheckoutprodapiapiidC96584B6F00A464EAD1953AFF4B05118Parameter",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "ExtendedStatistic": "p95",
        "MetricName": "Latency",
        "Namespace": "AWS/ApiGateway",
        "OKActions": [
          {
            "Ref": "AlarmTopicsP213C63151",
          },
        ],
        "Period": 600,
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout",
          },
          {
            "Key": "component",
            "Value": "observability",
          },
          {
            "Key": "env",
            "Value": "prod",
          },
          {
            "Key": "layer",
            "Value": "stateless",
          },
          {
            "Key": "managed-by",
            "Value": "cdk",
          },
        ],
        "Threshold": 2000,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "JourneyAlarmscheckoutbroken12502696": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicsP1E7C597D3",
          },
        ],
        "AlarmDescription": "P1 Checkout broken (J7, us-east-1). Any CheckoutSessionErrors for 5 minutes. Thresholds and runbooks: docs/journeys.md, Alarms for blocked journeys.",
        "AlarmName": "supply-checkout-prod-p1-checkout-broken",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Id": "m1",
            "Label": "CheckoutSessionErrors (us-east-1)",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "Region",
                    "Value": "us-east-1",
                  },
                ],
                "MetricName": "CheckoutSessionErrors",
                "Namespace": "SupplyCheckout",
