    "DataAccessRole27CE7E08": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
              ],
              "Condition": {
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "teamId",
                  ],
                },
                "StringLike": {
                  "aws:RequestTag/teamId": "?*",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "DataFunctionRole310517C7",
                    "Arn",
                  ],
                },
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Assumed by the data function per request, tagged with the team; reaches only that team's items",
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                  ],
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "TEAM#\${aws:PrincipalTag/teamId}",
                        "TEAM#\${aws:PrincipalTag/teamId}#SHEETS",
                      ],
                    },
                  },
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":dynamodb:us-west-2:",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":table/supply-checkout-prod-app",
                        ],
                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":dynamodb:us-west-2:",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":table/supply-checkout-prod-app/index/GSI1",
                        ],
                      ],
                    },
                  ],
                  "Sid": "TeamItemsOnly",
                },
                {
                  "Action": [
                    "kms:Decrypt",
                    "kms:DescribeKey",
                    "kms:Encrypt",
                    "kms:GenerateDataKey",
                  ],
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Join": [
                          "",
                          [
                            "dynamodb.",
                            {
                              "Ref": "AWS::Region",
                            },
                            ".amazonaws.com",
                          ],
                        ],
                      },
                    },
                  },
                  "Effect": "Allow",
                  "Resource": {
                    "Ref": "SsmParameterValuesupplycheckoutproddatatablekeyarnC96584B6F00A464EAD1953AFF4B05118Parameter",
                  },
                  "Sid": "TableKeyThroughDynamoDb",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "TeamPartitionOnly",
          },
        ],
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout",
          },
          {
            "Key": "component",
            "Value": "api",
          },
          {
            "Key": "env",
            "Value": "prod",
          },
          {
            "Key": "layer",
            "Value": "stateless",
          },
          {
            "Key": "managed-by",
            "Value": "cdk",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
