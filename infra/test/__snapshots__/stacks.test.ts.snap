      "Properties": {
        "Description": "SNS topic for P2 alarms in this region",
        "Name": "/supply-checkout/prod/observability/alarm-topic-p2-arn",
        "Tags": {
          "app": "supply-checkout",
          "component": "observability",
          "env": "prod",
          "layer": "stateless",
          "managed-by": "cdk",
        },
        "Type": "String",
        "Value": {
          "Ref": "AlarmTopicsP213C63151",
        },
      },
      "Type": "AWS::SSM::Parameter",
    },
    "AlarmTopicsKey1622932D": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": "Encrypts the Supply Checkout prod alarm topics",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":root",
                    ],
                  ],
                },
              },
              "Resource": "*",
            },
            {
              "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey*",
              ],
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId",
                  },
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com",
              },
              "Resource": "*",
            },
          ],
          "Version": "2012-10-17",
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout",
          },
          {
            "Key": "component",
            "Value": "observability",
          },
          {
            "Key": "env",
            "Value": "prod",
          },
          {
            "Key": "layer",
            "Value": "stateless",
          },
          {
            "Key": "managed-by",
            "Value": "cdk",
          },
        ],
      },
      "Type": "AWS::KMS::Key",
      "UpdateReplacePolicy": "Delete",
    },
    "AlarmTopicsP1E7C597D3": {
      "Properties": {
        "DisplayName": "Supply Checkout P1",
        "KmsMasterKeyId": {
          "Fn::GetAtt": [
            "AlarmTopicsKey1622932D",
            "Arn",
          ],
        },
        "Tags": [
          {
            "Key": "app",
            "Value": "supply-checkout",
          },
          {
            "Key": "component",
            "Value": "observability",
          },
          {
            "Key": "env",
            "Value": "prod",
          },
          {
            "Key": "layer",
            "Value": "stateless",
          },
          {
            "Key": "managed-by",
            "Value": "cdk",
          },
        ],
