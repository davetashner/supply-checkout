            "MetricStat": {
              "Metric": {
                "MetricName": "Invocations",
                "Namespace": "AWS/Lambda",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopicsP1E7C597D3",
          },
        ],
