{
  "name": "supply-checkout-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Lambda code for the Supply Checkout SaaS. src/data is the only code that talks to DynamoDB (ADR 0005).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test",
    "test:ddb": "node scripts/test-ddb.ts",
    "backfill": "esbuild scripts/backfill.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/backfill/backfill.mjs && node node_modules/.cache/backfill/backfill.mjs",
    "import-artifact": "esbuild scripts/import-artifact.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/import-artifact/import-artifact.mjs && node node_modules/.cache/import-artifact/import-artifact.mjs",
    "restore": "esbuild scripts/restore.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/restore/restore.mjs && node node_modules/.cache/restore/restore.mjs"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@aws-sdk/client-sts": "^3.1141.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.7.4",
    "aws-jwt-verify": "^5.2.1"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@eslint/js": "^10.0.1",
    "@smithy/types": "^4.19.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
